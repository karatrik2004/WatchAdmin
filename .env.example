# Xero Integration Settings
# Prefer GET /Invoices CurrencyRate before GET /Currencies (recommended — Currencies often omits rates).
XERO_FX_PREFER_INVOICES=true
# Allow DELETED/VOIDED invoices for FX when no other invoice qualifies (default false — avoids stale rates).
XERO_FX_ALLOW_DELETED_INVOICE_RATE=false
# Log raw GET /Currencies responses (status, JSON snippet, samples). Set false to reduce noise.
XERO_LOG_CURRENCIES_API=true
# INFO logs for each step of getExchangeRate (message: FX getExchangeRate). Set false to reduce log volume.
XERO_FX_LOG_GET_EXCHANGE_RATE_STEPS=true
# Today-only daily spot (Frankfurter/ECB) before Xero invoice/Currencies — avoids stale invoice CurrencyRate when deal date is today (UTC).
XERO_FX_EXTERNAL_SPOT_ENABLED=false
XERO_FX_EXTERNAL_CACHE_SECONDS=3600
XERO_FX_EXTERNAL_SPOT_URL=https://api.frankfurter.dev/latest
# Set your active Purchases/COGS account code from Xero below
XERO_PURCHASE_ACCOUNT_CODE=400
# Example: If your Purchases account code is 500, use XERO_PURCHASE_ACCOUNT_CODE=500
